// ============================================
// GYMVERSE - Complete Database Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH & USERS
// ============================================

enum UserRole {
  SUPER_ADMIN
  GYM_OWNER
  GYM_ADMIN
  TRAINER
  RECEPTIONIST
  CUSTOMER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  emailVerified   DateTime?
  phone           String?       @unique
  phoneVerified   DateTime?
  password        String?
  forcePasswordChange Boolean @default(false)
  resetToken      String?
  resetTokenExpires DateTime?
  name            String
  image           String?
  role            UserRole      @default(CUSTOMER)
  status          AccountStatus @default(PENDING_VERIFICATION)
  lastLoginAt     DateTime?
  loginAttempts   Int           @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  // Relations
  accounts        Account[]
  sessions        Session[]
  ownedGyms       Gym[]          @relation("GymOwner")
  gymStaff        GymStaff[]
  member          Member?
  trainer         Trainer?
  notifications   Notification[] @relation("UserNotifications")
  auditLogs       AuditLog[]
  supportTickets  SupportTicket[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// GYMS & TENANCY
// ============================================

enum GymStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
  DEACTIVATED
}

model Gym {
  id           String    @id @default(cuid())
  gymCode      String    @unique // e.g., GYM_001
  name         String
  slug         String    @unique
  logo         String?
  email        String
  phone        String
  address      String?
  city         String?
  state        String?
  country      String?   @default("India")
  gstNumber    String?
  description  String?   @db.Text
  status       GymStatus @default(PENDING_APPROVAL)
  onboarded    Boolean   @default(false)
  ownerId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  owner            User              @relation("GymOwner", fields: [ownerId], references: [id])
  settings         GymSettings?
  subscription     GymSubscription?
  staff            GymStaff[]
  members          Member[]
  membershipPlans  MembershipPlan[]
  memberships      Membership[]
  payments         Payment[]
  invoices         Invoice[]
  attendance       Attendance[]
  trainers         Trainer[]
  workoutPlans     WorkoutPlan[]
  dietPlans        DietPlan[]
  classes          GymClass[]
  equipment        Equipment[]
  expenses         Expense[]
  announcements    Announcement[]
  notifications    Notification[]
  whatsappSettings WhatsAppSettings?
  whatsappLogs     WhatsAppLog[]
  supportTickets   SupportTicket[]
  auditLogs        AuditLog[]
  notificationTemplates NotificationTemplate[]
  leads            Lead[]

  @@index([ownerId])

  @@index([status])
  @@index([gymCode])
  @@map("gyms")
}

model GymSettings {
  id                    String   @id @default(cuid())
  gymId                 String   @unique
  timezone              String   @default("Asia/Kolkata")
  currency              String   @default("INR")
  currencySymbol        String   @default("₹")
  dateFormat            String   @default("DD/MM/YYYY")
  workingDays           String[] @default(["MON", "TUE", "WED", "THU", "FRI", "SAT"])
  openingTime           String   @default("06:00")
  closingTime           String   @default("22:00")
  enableQrCheckin       Boolean  @default(true)
  enableWhatsapp        Boolean  @default(false)
  enableEmail           Boolean  @default(true)
  enableSms             Boolean  @default(false)
  expiryReminder30Days  Boolean  @default(true)
  expiryReminder15Days  Boolean  @default(true)
  expiryReminder7Days   Boolean  @default(true)
  expiryReminder3Days   Boolean  @default(true)
  expiryReminder1Day    Boolean  @default(true)
  autoSuspendOnExpiry   Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@map("gym_settings")
}

// ============================================
// GYM SUBSCRIPTIONS (SaaS billing)
// ============================================

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  PAST_DUE
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  BUSINESS
}

model GymSubscription {
  id             String             @id @default(cuid())
  gymId          String             @unique
  plan           SubscriptionPlan   @default(STARTER)
  status         SubscriptionStatus @default(TRIAL)
  price          Float              @default(0)
  startDate      DateTime           @default(now())
  endDate        DateTime
  trialEndsAt    DateTime?
  cancelledAt    DateTime?
  lastPaymentAt  DateTime?
  nextPaymentAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@map("gym_subscriptions")
}

// ============================================
// STAFF & PERMISSIONS
// ============================================

model GymStaff {
  id          String        @id @default(cuid())
  gymId       String
  userId      String
  role        UserRole      @default(RECEPTIONIST)
  permissions String[]      @default([])
  isActive    Boolean       @default(true)
  joinedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@index([gymId])
  @@map("gym_staff")
}

// ============================================
// MEMBERS
// ============================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Member {
  id               String    @id @default(cuid())
  memberId         String    @unique // e.g., GYM001-M-000124
  gymId            String
  userId           String    @unique
  profileImage     String?
  dateOfBirth      DateTime?
  gender           Gender?
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  joinDate         DateTime  @default(now())
  notes            String?   @db.Text
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  gym              Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships      Membership[]
  payments         Payment[]
  attendance       Attendance[]
  workoutPlans     WorkoutPlan[]
  dietPlans        DietPlan[]
  progressRecords  ProgressRecord[]
  assignedTrainer  Trainer?         @relation("TrainerMembers", fields: [trainerId], references: [id])
  trainerId        String?
  classBookings    ClassBooking[]

  @@index([gymId])
  @@index([memberId])
  @@map("members")
}

// ============================================
// MEMBERSHIP PLANS & MEMBERSHIPS
// ============================================

enum MembershipStatus {
  ACTIVE
  EXPIRED
  PAUSED
  CANCELLED
  PENDING
}

model MembershipPlan {
  id                   String   @id @default(cuid())
  gymId                String
  name                 String
  description          String?  @db.Text
  durationDays         Int
  price                Float
  features             String[] @default([])
  freezeDays           Int      @default(0)
  accessHoursStart     String?
  accessHoursEnd       String?
  classesIncluded      Boolean  @default(false)
  personalTraining     Boolean  @default(false)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([gymId])
  @@map("membership_plans")
}

model Membership {
  id             String           @id @default(cuid())
  gymId          String
  memberId       String
  planId         String
  status         MembershipStatus @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  pausedAt       DateTime?
  resumedAt      DateTime?
  cancelledAt    DateTime?
  daysRemaining  Int?
  autoRenew      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  gym     Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan    MembershipPlan @relation(fields: [planId], references: [id])
  payment Payment[]

  @@index([gymId])
  @@index([memberId])
  @@index([status])
  @@index([endDate])
  @@map("memberships")
}

// ============================================
// PAYMENTS & INVOICES
// ============================================

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
  PARTIAL
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  ONLINE
}

model Payment {
  id              String        @id @default(cuid())
  gymId           String
  memberId        String
  membershipId    String?
  amount          Float
  tax             Float         @default(0)
  discount        Float         @default(0)
  totalAmount     Float
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod @default(CASH)
  transactionId   String?
  gatewayResponse String?       @db.Text
  notes           String?
  paidAt          DateTime?
  dueDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  gym        Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id])
  invoice    Invoice?

  @@index([gymId])
  @@index([memberId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  gymId         String
  paymentId     String   @unique
  gymName       String
  gymAddress    String?
  gymGst        String?
  gymLogo       String?
  memberName    String
  memberEmail   String?
  memberPhone   String?
  items         Json     // Array of invoice items
  subtotal      Float
  tax           Float
  discount      Float
  total         Float
  notes         String?
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("invoices")
}

// ============================================
// ATTENDANCE
// ============================================

enum CheckinMethod {
  QR_SCAN
  MANUAL
  MEMBER_QR
}

model Attendance {
  id         String        @id @default(cuid())
  gymId      String
  memberId   String
  date       DateTime      @db.Date
  checkIn    DateTime
  checkOut   DateTime?
  method     CheckinMethod @default(MANUAL)
  staffId    String?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([date])
  @@map("attendance")
}

// ============================================
// TRAINERS
// ============================================

model Trainer {
  id             String   @id @default(cuid())
  gymId          String
  userId         String   @unique
  specialization String?
  experience     String?
  bio            String?  @db.Text
  certifications String[] @default([])
  schedule       Json?    // Weekly schedule
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  gym           Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  members       Member[]      @relation("TrainerMembers")
  workoutPlans  WorkoutPlan[]
  dietPlans     DietPlan[]
  classSessions GymClass[]

  @@index([gymId])
  @@map("trainers")
}

// ============================================
// WORKOUT PLANS
// ============================================

model WorkoutPlan {
  id          String   @id @default(cuid())
  gymId       String
  memberId    String
  trainerId   String?
  name        String
  description String?  @db.Text
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym       Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member    Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer   Trainer?           @relation(fields: [trainerId], references: [id])
  exercises WorkoutExercise[]

  @@index([gymId])
  @@index([memberId])
  @@map("workout_plans")
}

model WorkoutExercise {
  id           String  @id @default(cuid())
  workoutPlanId String
  dayOfWeek    String  // MON, TUE, etc.
  exerciseName String
  muscleGroup  String?
  sets         Int     @default(3)
  reps         String  @default("10") // Can be "10" or "8-12"
  weight       String? // e.g., "20kg"
  restSeconds  Int     @default(60)
  instructions String? @db.Text
  videoUrl     String?
  notes        String?
  sortOrder    Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  @@index([workoutPlanId])
  @@map("workout_exercises")
}

// ============================================
// DIET PLANS
// ============================================

model DietPlan {
  id          String   @id @default(cuid())
  gymId       String
  memberId    String
  trainerId   String?
  name        String
  description String?  @db.Text
  startDate   DateTime?
  endDate     DateTime?
  totalCalories Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym     Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer Trainer?   @relation(fields: [trainerId], references: [id])
  meals   DietMeal[]

  @@index([gymId])
  @@index([memberId])
  @@map("diet_plans")
}

model DietMeal {
  id         String  @id @default(cuid())
  dietPlanId String
  mealType   String  // BREAKFAST, LUNCH, DINNER, SNACK, PRE_WORKOUT, POST_WORKOUT
  time       String? // e.g., "08:00"
  foodItems  String  // e.g., "Oats, Milk, Banana, Eggs"
  calories   Int?
  protein    Float?
  carbs      Float?
  fats       Float?
  notes      String?
  sortOrder  Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dietPlan DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)

  @@index([dietPlanId])
  @@map("diet_meals")
}

// ============================================
// PROGRESS TRACKING
// ============================================

model ProgressRecord {
  id           String   @id @default(cuid())
  memberId     String
  date         DateTime @default(now())
  weight       Float?   // kg
  height       Float?   // cm
  bodyFat      Float?   // %
  chest        Float?   // cm
  waist        Float?   // cm
  arms         Float?   // cm
  thighs       Float?   // cm
  bmi          Float?
  progressPhoto String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([date])
  @@map("progress_records")
}

// ============================================
// CLASSES
// ============================================

model GymClass {
  id          String   @id @default(cuid())
  gymId       String
  trainerId   String?
  name        String
  description String?
  dayOfWeek   String
  startTime   String
  endTime     String
  maxCapacity Int      @default(20)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym      Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer  Trainer?       @relation(fields: [trainerId], references: [id])
  bookings ClassBooking[]

  @@index([gymId])
  @@map("gym_classes")
}

model ClassBooking {
  id       String   @id @default(cuid())
  classId  String
  memberId String
  date     DateTime @db.Date
  status   String   @default("BOOKED") // BOOKED, ATTENDED, CANCELLED
  createdAt DateTime @default(now())

  gymClass GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([memberId])
  @@map("class_bookings")
}

// ============================================
// EQUIPMENT
// ============================================

model Equipment {
  id             String   @id @default(cuid())
  gymId          String
  name           String
  category       String?
  brand          String?
  purchaseDate   DateTime?
  purchasePrice  Float?
  condition      String   @default("GOOD") // GOOD, FAIR, POOR, MAINTENANCE
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("equipment")
}

// ============================================
// EXPENSES
// ============================================

model Expense {
  id          String   @id @default(cuid())
  gymId       String
  category    String   // RENT, UTILITIES, SALARY, MAINTENANCE, SUPPLIES, OTHER
  description String
  amount      Float
  date        DateTime
  receipt     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([date])
  @@map("expenses")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  MEMBERSHIP_EXPIRY
  PAYMENT_REMINDER
  PAYMENT_RECEIVED
  ANNOUNCEMENT
  WORKOUT_UPDATE
  DIET_UPDATE
  GENERAL
  WELCOME
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  gymId     String?
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  gym  Gym?  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gymId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationTemplate {
  id        String @id @default(cuid())
  gymId     String
  type      NotificationType
  channel   String // EMAIL, WHATSAPP, SMS, IN_APP
  subject   String?
  body      String @db.Text
  variables String[] @default([]) // e.g., ["member_name", "gym_name"]
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("notification_templates")
}

// ============================================
// WHATSAPP
// ============================================

model WhatsAppSettings {
  id              String  @id @default(cuid())
  gymId           String  @unique
  provider        String? // e.g., "twilio", "meta"
  apiKey          String? // encrypted
  phoneNumberId   String?
  businessId      String?
  webhookUrl      String?
  isActive        Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@map("whatsapp_settings")
}

model WhatsAppLog {
  id          String   @id @default(cuid())
  gymId       String
  recipientPhone String
  templateName   String?
  message     String   @db.Text
  status      String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  response    String?  @db.Text
  createdAt   DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("whatsapp_logs")
}

// ============================================
// ANNOUNCEMENTS
// ============================================

model Announcement {
  id        String   @id @default(cuid())
  gymId     String
  title     String
  content   String   @db.Text
  priority  String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  isActive  Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("announcements")
}

// ============================================
// SUPPORT
// ============================================

model SupportTicket {
  id          String   @id @default(cuid())
  gymId       String?
  userId      String
  subject     String
  description String   @db.Text
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  response    String?  @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym  Gym?  @relation(fields: [gymId], references: [id])
  user User  @relation(fields: [userId], references: [id])

  @@index([gymId])
  @@index([status])
  @@map("support_tickets")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  gymId     String?
  userId    String
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  resource  String   // member, payment, membership, etc.
  resourceId String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  gym  Gym?  @relation(fields: [gymId], references: [id])
  user User  @relation(fields: [userId], references: [id])

  @@index([gymId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// LEADS & CRM
// ============================================

model Lead {
  id          String   @id @default(cuid())
  gymId       String
  name        String
  email       String?
  phone       String
  source      String   @default("WEBSITE_TRIAL")
  status      String   @default("NEW") // NEW, CONTACTED, TRIAL_BOOKED, CONVERTED, LOST
  trialDate   DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([status])
  @@map("leads")
}

